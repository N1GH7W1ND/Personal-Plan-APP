# ============================================================
#  我的工作台 · 版本库忽略规则
# ============================================================

# 个人数据：绝对不进版本库
# 这是你的任务、备忘、记录与打卡数据，只属于这台电脑。
# 备份同理（可能包含私人内容），也不入库。
data/

# 依赖目录（本项目零依赖，正常不会出现；防止误装后污染版本库）
node_modules/

# 锁文件：本项目明确零依赖，PRD 与测试都要求不存在锁文件
package-lock.json
yarn.lock
pnpm-lock.yaml

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 系统生成
Thumbs.db
Desktop.ini
.DS_Store

# 日志与临时文件（测试或排查时可能产生）
*.log
*.tmp
*.bak
_diag.json
_fail-dump.json
_probe*.txt
_repro*.txt
_mod-diag.txt
